{
  "name": "ha-wall-panel",
  "private": true,
  "description": "A touch-friendly Home Assistant wall dashboard for Android wall displays.",
  "license": "MIT",
  "author": "Elliot Ledger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eledg/ha-wall-panel.git"
  },
  "homepage": "https://github.com/eledg/ha-wall-panel#readme",
  "bugs": "https://github.com/eledg/ha-wall-panel/issues",
  "keywords": [
    "home-assistant",
    "dashboard",
    "wall-display",
    "preact"
  ],
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc -b",
    "schema:generate": "node scripts/generate-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate": "pnpm prettier:fix && pnpm lint:fix && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "home-assistant-js-websocket": "^9.7.1",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
