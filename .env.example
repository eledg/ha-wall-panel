# Public base path the built app is served from (must start and end with "/").
# HA serves /config/www/<folder>/ at /local/<folder>/.
WALL_BASE_PATH=/local/office-wall-display/

# Local dev only: the HA to connect to and a long-lived access token
# (HA profile, Security). Put real values in .env.local, which is git-ignored.
# Read by the dev server only (see dev-ha.ts): they are not VITE_ variables and
# never reach a build. On the display, HA signs in the trusted network
# automatically (see docs/deploy.md, "Signing in to HA").
# HA_DEV_URL=http://192.168.1.100:8123
# HA_DEV_TOKEN=
